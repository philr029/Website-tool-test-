{
  "suiteName": "Default Smoke Test Suite",
  "browser": "chromium",
  "headless": true,
  "viewport": { "width": 1280, "height": 800 },
  "reportDir": "reports",
  "screenshotDir": "screenshots",
  "flows": [
    {
      "id": "page-load-check",
      "name": "Example.com Page Load Check",
      "tags": ["smoke", "page-load"],
      "url": "https://example.com",
      "expectedTitle": "Example Domain",
      "expectedText": "Example Domain",
      "screenshotOnFailure": true,
      "screenshotOnSuccess": false,
      "retries": 1,
      "timeout": 30000,
      "steps": [
        {
          "name": "Verify page content",
          "expectedText": "This domain is for use in documentation examples"
        },
        {
          "name": "Click Learn more link",
          "clicks": [
            { "selector": "a[href='https://iana.org/domains/example']", "description": "Learn more link", "waitAfter": 1000 }
          ],
          "screenshot": false
        }
      ]
    }
  ]
}
